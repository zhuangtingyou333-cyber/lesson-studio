<view class="page"><view class="title">课程安排</view><view class="subtitle">北京时间 · 预约占位，到课扣课</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!ready}}" class="notice">请先在工作台选择体验身份。</view><block wx:else><button wx:if="{{owner}}" class="secondary" bindtap="toggle">{{showForm?'收起表单':'安排课程'}}</button><button wx:if="{{owner}}" id="open-series" class="secondary" bindtap="series">班级周期排课</button><form wx:if="{{showForm && owner}}" class="card" bindsubmit="save"><view class="label">课程</view><picker range="{{courses}}" range-key="name" value="{{courseIndex}}" data-key="courseIndex" bindchange="pick"><view class="picker">{{courses[courseIndex].name}}</view></picker><view class="label">授课老师</view><picker range="{{teachers}}" range-key="name" value="{{teacherIndex}}" data-key="teacherIndex" bindchange="pick"><view class="picker">{{teachers[teacherIndex].name}}</view></picker><view class="label">上课日期与时间</view><picker mode="date" value="{{date}}" data-key="date" bindchange="pick"><view class="picker">{{date||'请选择日期'}}</view></picker><picker mode="time" value="{{time}}" data-key="time" bindchange="pick"><view class="picker">{{time}}</view></picker><view class="label">教室</view><picker id="lesson-room" range="{{rooms}}" range-key="name" value="{{roomIndex}}" data-key="roomIndex" bindchange="pick"><view class="picker">{{rooms[roomIndex].name||'请先创建教室'}} · 容量{{rooms[roomIndex].capacity}}人</view></picker><view class="label">人数上限</view><input name="capacity" type="number" value="6"/><button form-type="submit" disabled="{{busy}}" loading="{{busy}}">保存课程</button></form><view wx:for="{{sessions}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="grow"><view class="muted">{{item.label}}</view><view class="card-title">{{item.class_name||item.course_name}}</view><view class="muted">{{item.teacher_name}} · {{item.room}} · {{item.cost}}次/课</view></view><text class="pill">{{item.status==='cancelled'?'已取消':item.booked+'/'+item.capacity+'人'}} ›</text></view></view><view wx:if="{{!sessions.length}}" class="empty">暂无课程</view></block></view>
