<view class="page"><view class="title">{{bookingId?'改约课程':'安排补课'}}</view><view class="subtitle">全部符合时间条件的课次 · 北京时间</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{sessions}}" wx:key="id" class="card"><view class="muted">{{item.label}}</view><view class="card-title">{{item.course_name}}</view><view class="row"><view class="muted">{{item.teacher_name}} · {{item.room}}</view><text class="pill">{{item.booked}}/{{item.capacity}}人</text></view><button class="secondary" data-id="{{item.id}}" bindtap="choose" disabled="{{busy}}">{{bookingId?'改约到这里':'选择这个时段'}}</button></view><view wx:if="{{!sessions.length}}" class="empty">暂无符合条件的未来课次，请联系教务安排。</view></view>
