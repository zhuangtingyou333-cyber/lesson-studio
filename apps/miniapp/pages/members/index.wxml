<view class="page">
  <view class="title">成员与邀请</view><view class="subtitle">核对身份后，再开放机构资料</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="secondary small" bindtap="refresh" disabled="{{busy}}">刷新成员</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <block wx:if="{{ready}}">
    <view wx:if="{{created}}" class="card"><view class="card-title">{{created.tokenAvailable?'邀请口令已生成':'邀请已创建'}}</view><view wx:if="{{created.inviteToken}}"><view class="muted">{{expiry}} 到期。口令仅本次显示，请妥善转交给本人。</view><text class="token" user-select>{{created.inviteToken}}</text><button id="copy-invite" bindtap="copy">复制口令</button></view><view wx:else class="notice">上次创建已成功，但口令不会再次显示。请撤销下方邀请后重新创建。</view><button class="secondary" bindtap="hideToken">完成并隐藏口令</button></view>
    <view class="section-label">待核对申请 · {{claims.length}}</view><view wx:if="{{!claims.length}}" class="empty">暂无待处理的加入申请</view>
    <view wx:for="{{claims}}" wx:key="id" class="card"><view class="row"><view class="card-title grow">{{item.display_name}}</view><text class="pill">{{item.roleLabel}}</text></view><view class="muted spacer">申请人填写：{{item.relationship}}</view><view wx:if="{{item.studentNames}}" class="muted">拟关联学员：{{item.studentNames}}</view><view class="actions"><button class="small" data-id="{{item.id}}" data-approve="yes" bindtap="startReview" disabled="{{busy}}">核对并通过</button><button class="small secondary" data-id="{{item.id}}" data-approve="no" bindtap="startReview" disabled="{{busy}}">拒绝申请</button></view><form wx:if="{{review.id===item.id}}" class="spacer" id="review-form" bindsubmit="reviewClaim"><view class="notice">{{review.approve?'请通过已知联系方式或当面确认本人身份及关系。口令和自填姓名不能代替核对。':'请填写拒绝原因，申请人可以看到。'}}</view><view class="label">{{review.approve?'核对方式与结果（申请人可见）':'拒绝原因'}}</view><input name="reason" maxlength="300" placeholder="请填写" disabled="{{busy}}"/><button form-type="submit" disabled="{{busy}}">{{review.approve?'已核对，确认通过':'确认拒绝'}}</button><button class="secondary" bindtap="cancelReview" disabled="{{busy}}">取消</button></form></view>
    <view class="section-label">邀请新成员</view><form id="invite-form" class="card" bindsubmit="create"><view class="label">加入身份</view><picker range="{{roles}}" value="{{roleIndex}}" bindchange="pick" disabled="{{busy}}"><view class="picker">{{roles[roleIndex]}}</view></picker><view class="label">邀请备注</view><input name="label" maxlength="80" placeholder="例如：小禾家长 / 新来的素描老师" disabled="{{busy}}"/><block wx:if="{{roleIndex===1}}"><view class="label">通过后关联的学员（最多20人）</view><checkbox-group id="invite-students" bindchange="studentsChanged"><label wx:for="{{students}}" wx:key="id" class="line row"><text class="grow">{{item.name}}</text><checkbox value="{{item.id}}" color="#007aff" disabled="{{busy}}"/></label></checkbox-group></block><view class="muted spacer">24小时内有效，仅供一人申请。收到申请后仍需管理员核对。</view><button form-type="submit" disabled="{{busy}}" loading="{{busy}}">生成邀请口令</button></form>
    <view class="section-label">机构成员 · {{members.length}}</view><view wx:for="{{members}}" wx:key="user_id" class="card"><view class="row"><view class="card-title grow">{{item.display_name}}</view><text class="pill">{{item.roleLabel}} · {{item.active?'正常':'已停用'}}</text></view><view wx:for="{{item.students}}" wx:for-item="student" wx:key="id" class="line row"><text class="grow">{{student.name}}</text><button class="small danger" data-id="{{item.user_id}}" data-student="{{student.id}}" bindtap="unlink" disabled="{{busy}}">解除关联</button></view><view wx:if="{{item.upcoming}}" class="muted spacer">{{item.upcoming}}节课程尚未结束</view><button class="small secondary spacer" data-id="{{item.user_id}}" bindtap="active" disabled="{{busy}}">{{item.active?'停用成员':'恢复成员'}}</button></view>
    <view class="section-label">邀请记录</view><view wx:for="{{invitations}}" wx:key="id" class="card"><view class="row"><view class="card-title grow">{{item.label}}</view><text class="pill">{{item.stateLabel}}</text></view><view class="muted">{{item.roleLabel}} · {{item.expiry}} 到期</view><button wx:if="{{item.state!=='revoked'}}" class="secondary small" data-id="{{item.id}}" bindtap="revoke" disabled="{{busy}}">撤销邀请</button></view>
  </block>
</view>
