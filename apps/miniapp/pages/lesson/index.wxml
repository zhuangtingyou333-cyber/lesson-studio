<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{lesson}}"><view class="title">{{lesson.course_name}}</view><view class="subtitle">{{label}} · {{lesson.teacher_name}} · {{lesson.room}}</view><button class="secondary small" bindtap="reloadRecords" disabled="{{busy}}">重新加载记录</button><view wx:if="{{lesson.status==='scheduled' && !lesson.room_active}}" class="notice">本节课所在教室已停用，不能增加预约。请联系管理员调整教室；已有记录保留。</view><view wx:if="{{lesson.status==='cancelled'}}" class="notice">本节课已取消，预约已释放。历史记录保留，可在下方查看变更原因。</view><button wx:if="{{role==='owner' && !started && lesson.status==='scheduled'}}" id="manage-lesson" class="secondary" bindtap="manage">调整 / 取消课程</button><view wx:if="{{lesson.status==='scheduled'}}" class="notice">{{lesson.booked}} / {{lesson.capacity}}人。普通到课扣课；原课已扣的补课不重复扣。缺席不扣课，更正保留流水。{{started?'':'课程开始后可点名。'}}</view><view wx:if="{{!started && role!=='teacher' && lesson.status==='scheduled' && lesson.room_active}}" class="card"><view class="card-title">{{makeupId?'使用补课资格预约':'预约学员'}}</view><picker range="{{students}}" range-key="name" value="{{studentIndex}}" data-key="studentIndex" bindchange="pick" disabled="{{!!makeupId}}"><view class="picker">{{students[studentIndex].name||'暂无学员'}}</view></picker><button bindtap="book" disabled="{{busy}}">确认预约</button></view><block wx:if="{{role!=='guardian' && started && lesson.status==='scheduled'}}">
  <button id="batch-toggle" class="secondary" bindtap="openBatch" disabled="{{busy}}">{{batchOpen?'收起批量点名':'全班批量点名'}}</button>
  <form wx:if="{{batchOpen}}" class="card" bindsubmit="submitBatch">
    <view class="card-title">选择学员与出勤状态</view>
    <view class="muted">仅包含待点名学员，默认选中到课；请核对缺席人员。</view>
    <checkbox-group bindchange="selectBatch">
      <view wx:for="{{batchRows}}" wx:key="id" class="line">
        <label class="row"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy}}" color="#007aff"/><text class="grow">{{item.student_name}}</text></label>
        <picker class="spacer" range="{{batchStatuses}}" value="{{item.statusIndex}}" data-id="{{item.id}}" bindchange="batchStatus" disabled="{{busy}}"><view class="picker">{{item.statusIndex===0 && item.prepaid?'到课 · 原课已扣':batchStatuses[item.statusIndex]}}</view></picker>
      </view>
    </checkbox-group>
    <view wx:if="{{!batchRows.length}}" class="empty">本节课已无待点名学员。</view>
    <view class="label">记录原因</view><input name="reason" maxlength="300" placeholder="例如：本次课程出勤核对完成" disabled="{{busy}}"/>
    <view class="notice">已选 {{batchCount}} 人。一人余额不足或记录变化，整批都不会保存。已点名学员请单独更正。</view>
    <button form-type="submit" disabled="{{busy || !batchCount}}" loading="{{busy}}">确认 {{batchCount}} 人点名</button>
  </form>
</block><view wx:for="{{bookings}}" wx:key="id" class="card"><view class="row"><view class="card-title">{{item.student_name}}</view><text class="pill">{{item.label}}</text></view><view wx:if="{{item.pending}}" class="notice">请假待审批，原预约暂时保留。</view><view wx:if="{{item.prepaid}}" class="muted">原课已扣，本次补课到课不重复扣。</view><view class="actions"><button wx:if="{{role!=='guardian' && started && (item.state==='confirmed'||item.state==='attended'||item.state==='absent')}}" class="small" data-id="{{item.id}}" bindtap="point">{{item.revision?'更正记录':'点名'}}</button><block wx:if="{{role!=='teacher' && item.state==='confirmed'}}"><button class="small secondary" data-id="{{item.id}}" data-op="reschedule" bindtap="change" disabled="{{busy}}">改约</button><button class="small secondary" data-id="{{item.id}}" data-op="cancel" bindtap="change" disabled="{{busy}}">取消</button></block><button wx:if="{{!item.makeup_id && !item.pending && (role==='owner' && (item.state==='confirmed'||item.state==='attended'||item.state==='absent') || role==='guardian' && !started && item.state==='confirmed')}}" class="small secondary" data-id="{{item.id}}" data-op="leave" bindtap="change" disabled="{{busy}}">申请请假</button><button class="small secondary" data-id="{{item.id}}" bindtap="leaves">请假记录</button></view><form wx:if="{{attendanceId===item.id}}" bindsubmit="submitAttendance"><view class="label">点名状态</view><picker range="{{statuses}}" value="{{statusIndex}}" data-key="statusIndex" bindchange="pick"><view class="picker">{{statuses[statusIndex]}}</view></picker><view class="label">记录原因</view><input name="reason" placeholder="例如：确认到课 / 误点更正" maxlength="300"/><button form-type="submit" disabled="{{busy}}" loading="{{busy}}">保存点名</button></form></view><view wx:if="{{!bookings.length}}" class="empty">暂无可见预约</view><view wx:if="{{changes.length}}" class="spacer card-title">课程变更记录</view><view wx:for="{{changes}}" wx:key="id" class="card"><view class="card-title">{{item.action==='cancel'?'取消课程':'调整课程'}}</view><view class="muted">{{item.beforeLabel}}</view><view class="positive">{{item.afterLabel}}</view><view class="line">{{item.reason}}</view><view class="muted">{{item.label}} · {{item.actor_name}} · 版本{{item.version}}</view></view></block></view>
