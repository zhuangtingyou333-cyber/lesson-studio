<view class="page"><view class="title">学员档案</view><view class="subtitle">只展示当前身份可见的学员</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!ready}}" class="notice">请先在工作台选择体验身份。</view><block wx:else><button wx:if="{{owner}}" id="open-imports" class="secondary" bindtap="imports">导入名单与期初课时</button><button wx:if="{{owner}}" class="secondary" bindtap="toggle">{{showForm?'收起表单':'新增学员 / 开通课包'}}</button><block wx:if="{{showForm && owner}}"><form class="card" bindsubmit="add"><view class="card-title">新增学员</view><view class="label">姓名</view><input name="name" maxlength="80" placeholder="学员姓名"/><view class="label">联系方式（选填）</view><input name="phone" maxlength="24"/><view class="label">备注（选填）</view><textarea name="note" maxlength="500"/><button form-type="submit" disabled="{{busy}}">保存学员</button></form><form class="card" bindsubmit="enroll"><view class="card-title">开通课包</view><view class="label">学员</view><picker range="{{enrollable}}" range-key="name" value="{{studentIndex}}" data-key="studentIndex" bindchange="pick"><view class="picker">{{enrollable[studentIndex].name||'请先建档'}}</view></picker><view class="label">课包</view><picker range="{{packages}}" range-key="name" value="{{packageIndex}}" data-key="packageIndex" bindchange="pick"><view class="picker">{{packages[packageIndex].name}}</view></picker><view class="label">开通来源</view><picker range="{{sources}}" value="{{sourceIndex}}" data-key="sourceIndex" bindchange="pick"><view class="picker">{{sources[sourceIndex]}}</view></picker><view class="label">已实收金额（元），迁入请填0</view><input name="received" value="0" type="digit"/><view class="notice">只登记已收款项，不会发起支付。</view><button form-type="submit" disabled="{{busy}}">开通课包</button></form></block><button class="small secondary" bindtap="filter">{{showArchived?'隐藏归档':'显示归档'}}</button><block wx:for="{{students}}" wx:key="id"><view wx:if="{{showArchived || item.active}}" class="card"><view class="row" data-id="{{item.id}}" bindtap="detail"><view class="grow"><view class="card-title">{{item.name}} {{item.active?'':'（已归档）'}}</view><view class="muted">{{item.note||'点击查看课包'}}</view></view><view class="positive">{{item.amount}} 次 ›</view></view><button wx:if="{{owner}}" class="small secondary" data-id="{{item.id}}" bindtap="edit">维护档案</button></view></block><view wx:if="{{!students.length}}" class="empty">暂无可见学员</view></block></view>
