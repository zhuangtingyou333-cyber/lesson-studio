<view class="page">
 <view class="title">请假记录</view><view class="subtitle">申请、审批和补课，有据可查</view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
 <button class="secondary" bindtap="reload" disabled="{{busy}}">重新加载记录</button>
 <block wx:if="{{ready}}">
  <view class="actions"><button class="small {{onlyPending?'secondary':''}}" data-pending="no" bindtap="filter" disabled="{{busy}}">全部记录</button><button class="small {{onlyPending?'':'secondary'}}" data-pending="yes" bindtap="filter" disabled="{{busy}}">待审批 {{pending}}</button></view>
  <block wx:if="{{role==='owner'}}"><button id="leave-policy" class="text-button" bindtap="policyToggle" disabled="{{busy}}">{{policyOpen?'收起请假规则':'设置请假规则'}}</button>
   <form wx:if="{{policyOpen}}" class="card" bindsubmit="savePolicy">
    <view class="card-title">机构请假规则</view><view class="muted">全部申请由管理员审批。新规则仅用于之后提交的申请，旧记录保留当时规则。</view>
    <view class="label">家长提前多少分钟申请</view><input name="cutoff" type="number" value="{{policy.cutoffMinutes}}" disabled="{{busy}}"/><view class="muted">0–10080分钟，0表示上课前均可申请。超时由管理员核对办理。</view>
    <view class="label">补课有效天数</view><input name="days" type="number" value="{{policy.validDays}}" disabled="{{busy}}"/><view class="muted">1–365天，从审批和原课时间中较晚者起算。</view>
    <view class="label">通过后的扣课方式</view><picker range="{{charges}}" value="{{chargeIndex}}" bindchange="pick" disabled="{{busy}}"><view class="picker">{{charges[chargeIndex]}}</view></picker>
    <view class="label">调整原因</view><input name="reason" maxlength="300" placeholder="说明这次规则调整" disabled="{{busy}}"/>
    <button form-type="submit" loading="{{busy}}" disabled="{{busy}}">保存新规则</button>
   </form>
  </block>
  <view wx:if="{{!rows.length}}" class="empty">{{onlyPending?'暂无待审批申请':'暂无请假记录，可从课程详情提交申请。'}}</view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
   <view class="row"><view class="grow card-title">{{item.student_name}} · {{item.course_name}}</view><text class="pill">{{item.label}}</text></view>
   <view class="muted">原课 {{item.time}}</view><view class="line">{{item.reason}}</view><view class="muted">{{item.requester_name}} · {{item.created}} 提交</view><view class="muted">{{item.rule}}</view>
   <view wx:if="{{item.status==='pending' || item.status==='approved'}}" class="notice">{{item.status==='pending'?'若通过：':'当前：'}}{{item.result}}。{{item.status==='pending'?'审批前保留原名额，课时暂不变化。':''}}{{item.expiry?'补课有效至 '+item.expiry+'。':''}}</view>
   <view wx:if="{{item.makeupLabel}}" class="muted">{{item.makeupLabel}}</view>
   <view class="actions">
    <block wx:if="{{role==='owner' && item.status==='pending'}}"><button class="small" data-id="{{item.id}}" data-op="leave_review" data-approve="yes" bindtap="start" disabled="{{busy}}">通过</button><button class="small secondary" data-id="{{item.id}}" data-op="leave_review" data-approve="no" bindtap="start" disabled="{{busy}}">驳回</button></block>
    <button wx:if="{{item.canWithdraw}}" class="small secondary" data-id="{{item.id}}" data-op="leave_withdraw" bindtap="start" disabled="{{busy}}">撤回申请</button>
    <button wx:if="{{role==='owner' && item.status==='approved'}}" class="small secondary" data-id="{{item.id}}" data-op="leave_correct" bindtap="start" disabled="{{busy}}">更正扣课</button>
    <button wx:if="{{item.makeupSession || item.canArrange}}" class="small secondary" data-id="{{item.id}}" bindtap="makeup" disabled="{{busy}}">{{item.makeupSession?'查看补课':'安排补课'}}</button>
    <button class="small secondary" data-id="{{item.id}}" bindtap="lesson">查看原课</button>
   </view>
   <form wx:if="{{review.id===item.id}}" class="review" bindsubmit="submit"><view class="card-title">{{review.title}}</view><view class="muted">{{review.summary}}</view><view class="label">处理原因</view><input name="reason" maxlength="300" placeholder="请填写核对结果或更正原因" disabled="{{busy}}"/><button form-type="submit" loading="{{busy}}" disabled="{{busy}}">确认{{review.title}}</button><button class="text-button" bindtap="cancelReview" disabled="{{busy}}">暂不处理</button></form>
   <view class="section-label">处理记录</view><view wx:for="{{item.history}}" wx:for-item="entry" wx:key="version" class="line"><view class="muted">{{entry.title}}</view><view>{{entry.detail}}</view></view>
  </view>
 </block>
</view>
