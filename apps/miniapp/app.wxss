/* Native WeChat controls with an iOS-inspired grouped layout. */
page {
  background: #f2f2f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.title { font-size: 60rpx; line-height: 1.22; font-weight: 700; letter-spacing: -1rpx; margin: 8rpx 0 12rpx; }
.subtitle, .muted { font-size: 26rpx; color: #636366; line-height: 1.6; }
.card { background: #fff; border-radius: 24rpx; padding: 30rpx; margin: 24rpx 0; }
.card-title { font-size: 32rpx; font-weight: 600; line-height: 1.4; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.row > .card-title { margin-bottom: 0; }
.grow { flex: 1; min-width: 0; overflow-wrap: break-word; }
.stats { display: flex; gap: 20rpx; }
.stats .card { flex: 1; min-width: 0; margin: 24rpx 0 0; }
.number { font-size: 58rpx; line-height: 1.15; font-weight: 600; letter-spacing: -1rpx; margin: 16rpx 0 8rpx; font-variant-numeric: tabular-nums; }
.positive { color: #0066cc; }
.negative { color: #b45309; }
.pill { display: inline-block; flex-shrink: 0; font-size: 23rpx; background: #eef5ff; color: #0066cc; padding: 7rpx 16rpx; border-radius: 30rpx; }
.notice { font-size: 25rpx; line-height: 1.7; color: #636366; background: #e9e9ef; border-radius: 20rpx; padding: 24rpx; margin: 24rpx 0; }
.error { background: #fff0ee; color: #b42318; border-radius: 20rpx; padding: 24rpx; margin: 24rpx 0; line-height: 1.65; font-size: 27rpx; }
.page button:not([size='mini']) { width: 100%; }
button { width: 100%; box-sizing: border-box; font-size: 30rpx; font-weight: 600; margin-top: 24rpx; padding: 22rpx 24rpx; min-height: 88rpx; background: #007aff; color: #fff; border-radius: 22rpx; line-height: 1.5; }
button::after { border: 0; }
button[disabled] { background: #e5e5ea !important; color: #8e8e93 !important; }
button.secondary { background: #e8f1ff; color: #0066cc; }
button.danger { background: #fff0ee; color: #b42318; }
.page button.small { width: auto; font-size: 26rpx; font-weight: 500; padding: 18rpx 22rpx; margin: 0; min-height: 80rpx; line-height: 1.5; }
button.text-button { background: transparent; color: #0066cc; padding: 12rpx 0; min-height: 72rpx; text-align: left; }
.button-hover { opacity: 0.72; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 22rpx; }
.page .actions button { margin: 0; width: auto; }
.label { font-size: 26rpx; font-weight: 500; color: #48484a; margin: 26rpx 0 12rpx; }
form .label:first-child { margin-top: 0; }
input, textarea, .picker { box-sizing: border-box; width: 100%; min-height: 92rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #f2f2f7; font-size: 30rpx; color: #1c1c1e; }
input { height: 92rpx; }
textarea { height: 180rpx; line-height: 1.5; }
picker + picker { margin-top: 12rpx; }
.picker { padding-right: 48rpx; position: relative; }
.picker::after { content: '›'; color: #8e8e93; position: absolute; right: 22rpx; top: 21rpx; }
.line { padding: 24rpx 0; border-bottom: 1rpx solid #e5e5ea; }
.line:last-child { border-bottom: 0; padding-bottom: 0; }
.empty { padding: 44rpx 24rpx; text-align: center; color: #636366; font-size: 27rpx; line-height: 1.7; background: #fff; border-radius: 24rpx; margin: 24rpx 0; }
.spacer { margin-top: 40rpx; }
.section-label { margin: 36rpx 16rpx 12rpx; font-size: 25rpx; color: #636366; }
.footer { text-align: center; color: #636366; font-size: 23rpx; margin-top: 40rpx; }
form { display: block; }
.weekdays { display: flex; flex-wrap: wrap; gap: 24rpx; margin: 20rpx 0; }
.weekdays label { display: flex; align-items: center; gap: 6rpx; min-height: 80rpx; }
.group { background: #fff; border-radius: 24rpx; padding: 0 28rpx; margin: 16rpx 0 24rpx; overflow: hidden; }
button.nav-row { display: flex; align-items: center; gap: 20rpx; width: 100%; background: #fff; color: #1c1c1e; margin: 0; padding: 26rpx 0; border-radius: 0; border-bottom: 1rpx solid #e5e5ea; text-align: left; font-size: 30rpx; font-weight: 400; min-height: 108rpx; }
button.nav-row:last-child { border-bottom: 0; }
.nav-row .chevron { color: #8e8e93; font-size: 38rpx; font-weight: 400; }
.nav-detail { display: block; font-size: 24rpx; line-height: 1.6; color: #636366; margin-top: 4rpx; }
.nav-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; flex-shrink: 0; border-radius: 15rpx; background: #e8f1ff; color: #0066cc; font-size: 26rpx; font-weight: 600; }
.token { display: block; word-break: break-all; font-family: monospace; font-size: 26rpx; background: #f2f2f7; border-radius: 16rpx; padding: 24rpx; margin-top: 20rpx; }
